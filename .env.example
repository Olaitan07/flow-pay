# Copy to .env and change values. .env is git-ignored. Never commit real secrets.
POSTGRES_USER=flowpay
POSTGRES_PASSWORD=change-me

# Shared secret for service-to-service calls (user-service -> auth-service). Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# RS256 signing keys, base64 DER on one line. Only auth-service gets the private key.
# Generate:
#   openssl genrsa -out key.pem 2048
#   JWT_PRIVATE_KEY=$(openssl pkcs8 -topk8 -nocrypt -in key.pem -outform DER | base64 | tr -d '\n')
#   JWT_PUBLIC_KEY=$(openssl rsa -in key.pem -pubout -outform DER | base64 | tr -d '\n')
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
