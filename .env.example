# Copy to .env and change values. .env is git-ignored. Never commit real secrets.
POSTGRES_USER=flowpay
POSTGRES_PASSWORD=change-me

# Shared secret for service-to-service calls (user-service -> auth-service). Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# RS256 signing keys, base64 DER on one line. Only auth-service gets the private key.
# Generate:
#   openssl genrsa -out key.pem 2048
#   JWT_PRIVATE_KEY=$(openssl pkcs8 -topk8 -nocrypt -in key.pem -outform DER | base64 | tr -d '\n')
#   JWT_PUBLIC_KEY=$(openssl rsa -in key.pem -pubout -outform DER | base64 | tr -d '\n')
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Email. Defaults send to the local Mailpit container (inbox at http://localhost:8025).
# For a real provider set MAIL_HOST/MAIL_PORT (and add credentials support before using one in production).
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_FROM=no-reply@flowpay.local
# Page in your customer-facing app that receives ?token=... from the password reset email.
# PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Swagger UI and OpenAPI endpoints. Set to false in production.
# DOCS_ENABLED=true
